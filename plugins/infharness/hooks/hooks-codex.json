{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-harnesskit\" codex \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 5
          }
        ],
        "matcher": "^(mcp__infharness__append_repository_observations|mcp__infharness__get_repository_observation_promotion_snapshot|mcp__infharness__prepare_repository_observation_promotions|mcp__infharness__record_repository_observation_promotions)$"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-harnesskit\" codex \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 5
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-harnesskit\" codex \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${HOME}/.local/bin/harnesskit\" sync run --plugin-root \"${PLUGIN_ROOT}\"",
            "async": true,
            "timeout": 65
          }
        ]
      }
    ]
  }
}
