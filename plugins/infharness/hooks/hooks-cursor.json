{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/scripts/run-harnesskit\" cursor \"${CURSOR_PLUGIN_ROOT}\"",
        "timeout": 5,
        "matcher": "^(MCP:append_repository_observations|MCP:get_repository_observation_promotion_snapshot|MCP:prepare_repository_observation_promotions|MCP:record_repository_observation_promotions)$"
      }
    ],
    "postToolUse": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/scripts/run-harnesskit\" cursor \"${CURSOR_PLUGIN_ROOT}\"",
        "timeout": 5,
        "matcher": "Shell"
      }
    ],
    "sessionStart": [
      {
        "command": "sh \"${CURSOR_PLUGIN_ROOT}/scripts/run-harnesskit\" cursor \"${CURSOR_PLUGIN_ROOT}\"",
        "timeout": 5
      },
      {
        "command": "\"${HOME}/.local/bin/harnesskit\" sync run --host cursor --plugin-root \"${CURSOR_PLUGIN_ROOT}\" --plugin-contract 1",
        "timeout": 65
      }
    ]
  }
}
