#!/bin/sh
set -eu

# Claude Code treats Hook exit 2 as a blocking error. The launcher therefore
# returns only 0 (CLI succeeded) or 1 (any launcher or CLI failure).
if [ "$#" -ne 2 ] && [ "$#" -ne 3 ]; then
	echo "infharness: expected host and plugin root" >&2
	exit 1
fi

host=$1
plugin_root=$2
case "$host" in
	codex|claude|cursor) ;;
	*)
		echo "infharness: unsupported host $host" >&2
		exit 1
		;;
esac
launcher_home=${HOME:-}
# Git for Windows supplies sh and cygpath for native Plugin launchers.
if [ "${OS:-}" = Windows_NT ]; then
 plugin_root=$(cygpath -u "$plugin_root")
 launcher_home=$(cygpath -u "${USERPROFILE:-$launcher_home}")
fi
case "$plugin_root" in
	/*) ;;
	*)
		echo "infharness: plugin root must be absolute" >&2
		exit 1
		;;
esac
case "$launcher_home" in
	/*) ;;
	*)
		echo "infharness: HOME must be an absolute path" >&2
		exit 1
		;;
esac

binary="${launcher_home}/.local/bin/harnesskit"
if [ "${OS:-}" = Windows_NT ]; then binary="${binary}.exe"; fi
if [ ! -x "$binary" ]; then
	echo "infharness: canonical $binary is not installed" >&2
	exit 1
fi
# A strict old CLI rejects this flag before invoking any Hook handler. Never
# retry without negotiation: release versions do not establish compatibility.
if [ "$host" = cursor ]; then
	if [ "$#" -ne 3 ]; then
		echo "runtime_instance_unavailable: Plugin instance has changed; reload the host Session" >&2
		exit 1
	fi
	set -- hook "--$host" --plugin-root "$plugin_root" --plugin-contract 1 --plugin-instance "$3"
else
	if [ "$#" -ne 2 ]; then
		echo "infharness: unexpected instance argument" >&2
		exit 1
	fi
	set -- hook "--$host" --plugin-root "$plugin_root" --plugin-contract 1
fi

# Run the CLI in the background so HUP/INT/TERM traps run while waiting.
# Background jobs ignore INT, so every host termination is forwarded as TERM.
# The launcher exits only after the CLI has been reaped.
child=
stopping=
stop() {
	stopping=1
	if [ -n "$child" ]; then
		kill -TERM "$child" 2>/dev/null || :
	fi
}
trap stop HUP INT TERM
# Asynchronous commands default to /dev/null stdin; keep the Hook event.
# `command` keeps a closed stdin from exiting the shell with status 2.
if ! command exec 3<&0; then
	echo "infharness: Hook input is unavailable" >&2
	exit 1
fi
"$binary" "$@" <&3 3<&- &
child=$!
exec 3<&-
if [ -n "$stopping" ]; then
	kill -TERM "$child" 2>/dev/null || :
fi
while :; do
	status=0
	wait "$child" || status=$?
	# Above 128 is either a trap interrupting wait or a signaled CLI; keep
	# waiting while the CLI process still exists.
	if [ "$status" -le 128 ] || ! kill -0 "$child" 2>/dev/null; then
		break
	fi
done
if [ "$status" -ne 0 ]; then
	exit 1
fi
exit 0
